{
  "name": "ai-newsreel-compositor",
  "version": "1.0.0",
  "description": "AI Avatar News Reel Video Compositor — Remotion-based 9:16 vertical video renderer",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render NewsReel --props=./src/props.json",
    "render": "remotion render NewsReel",
    "render:props": "remotion render NewsReel --props",
    "upgrade": "npx remotion upgrade"
  },
  "dependencies": {
    "@remotion/captions": "4.0.462",
    "@remotion/cli": "4.0.462",
    "@remotion/media-utils": "4.0.462",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.462",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
