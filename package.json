    "gray-matter": "^4.0.3",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.24.0",
    "marked": "^17.0.4",
    "next": "^16.1.6",
    "next-mdx-remote": "^6.0.0",
    "node-fetch": "^3.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^2.15.1",
