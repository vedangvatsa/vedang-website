{
  "name": "vedang",
  "version": "0.1.0",
  "private": true,
  "description": "Official repository and TypeScript/JavaScript SDK for Vedang Vatsa and Veda (veda.ng) APIs and Model Context Protocol (MCP) servers.",
  "homepage": "https://veda.ng",
  "repository": {
    "type": "git",
    "url": "https://github.com/vedangvatsa/vedang-website.git"
  },
  "author": {
    "name": "Vedang Vatsa",
    "url": "https://veda.ng/about"
  },
  "bugs": {
    "url": "https://github.com/vedangvatsa/vedang-website/issues"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "npx tsx scripts/generate-openapi.ts && npx tsx scripts/generate-llms-files.ts && npx tsx scripts/generate-agent-manifest.ts && node scripts/generate-rss.mjs && npx tsx scripts/generate-default-reports.ts && npx tsx scripts/generate-essay-og.ts && next build",
    "start": "next start",
    "lint": "eslint . && npx tsx scripts/check-ai-slop.ts",
    "lint:slop": "npx tsx scripts/check-ai-slop.ts",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test tests/**/*.test.ts",
    "build:worker": "opennextjs-cloudflare build",
    "x:authorize": "npx tsx scripts/x-authorize.ts",
    "x:post-essays": "npx tsx scripts/x-auto-post.ts",
    "x:thread": "npx tsx scripts/x-post-thread.ts",
    "indexnow": "bash scripts/submit-indexnow.sh",
    "indexnow:ts": "npx tsx scripts/submit-indexnow.ts",
    "backlink:matrix": "npx tsx scripts/backlink-tool.ts",
    "backlink:ping": "npx tsx scripts/mass-1000-backlink-indexer.ts"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@microsoft/clarity": "^1.0.2",
    "@next/mdx": "^16.1.6",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@tailwindcss/typography": "^0.5.14",
    "@types/form-data": "^2.2.1",
    "@types/mdx": "^2.0.13",
    "@types/node-fetch": "^2.6.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "firebase": "^11.9.1",
    "form-data": "^4.0.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.24.0",
    "marked": "^17.0.4",
    "next": "^16.1.6",
    "next-mdx-remote": "^6.0.0",
    "node-fetch": "^3.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^2.15.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.16.2",
    "typescript": "^5"
  },
  "overrides": {
    "glob": "^13.0.0",
    "undici": "^7.23.0",
    "formdata-node": "^6.0.3"
  }
}
