{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Veda Authentication Specification",
  "version": "1.0.0",
  "description": "Public authentication and security specification for Veda (veda.ng). Keyless and open-access.",
  "documentation": "https://veda.ng/auth.md",
  "auth_type": "none",
  "identity_types_supported": [
    "anonymous",
    "identity_assertion"
  ],
  "oauth_metadata": "https://veda.ng/.well-known/oauth-protected-resource",
  "register_uri": "https://veda.ng/api/auth/register",
  "revocation_uri": "https://veda.ng/api/auth/revoke"
}
