{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "veda-social-video",
  "account_id": "98dc3d9d6a9efe3231032ff064ac0a01",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "routes": [
    { "pattern": "veda.ng/api/social-video/*", "zone_name": "veda.ng" },
    { "pattern": "www.veda.ng/api/social-video/*", "zone_name": "veda.ng" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
